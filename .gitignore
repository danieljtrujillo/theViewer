# Build output. Tens of gigabytes once the dependency tree is compiled.
/target/
*.pdb

# Editor and tool state, per-machine by nature.
.vscode/
.idea/
.serena/
.playwright-mcp/
*.code-workspace

# Written by tools/build-and-run.ps1 on every launch.
/tools/build.log

# Test corpus. Regenerated by `node tools/make-corpus.mjs`, deterministic, and large.
/corpus/

# Sample media. Captures, scans and splat files are large binaries that belong on disk
# rather than in history. Anchored so nothing under docs/ is caught.
*.ares
*.spz
*.splat
*.sog
*.4ds
*.laz
*.las
*.e57
*.dcm
*.nii
*.nii.gz
*.nrrd
*.mha

# Scratch renders. `viewer shot` writes PNGs, and none of them are documentation.
# Anchored to the repository root, so docs/images/ is unaffected.
/*.png
/*.jpg
/*.jpeg
/.tmp-shots/

# Local notes that are not user documentation.
/docs/plans/
/docs/audits/
/docs/changes/

# Cargo.lock is deliberately NOT ignored. This workspace ships a binary, so the lock file
# is part of the build's reproducibility rather than a library author's inconvenience.
